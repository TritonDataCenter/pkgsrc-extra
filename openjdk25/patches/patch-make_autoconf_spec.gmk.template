@@ -665,18 +665,18 @@ JAVA = $(JAVA_CMD) $(JAVA_FLAGS_BIG) $(J
 JAVA_SMALL = $(JAVA_CMD) $(JAVA_FLAGS_SMALL) $(JAVA_FLAGS)
