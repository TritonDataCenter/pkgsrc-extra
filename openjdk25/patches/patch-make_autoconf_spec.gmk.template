 # LDFLAGS used to link the jdk native launchers (C-code)
-LDFLAGS_JDKEXE := @LDFLAGS_JDKEXE@
+LDFLAGS_JDKEXE := -Xlinker -R@JAVA_HOME@/lib -Xlinker -R@JAVA_HOME@/lib/server @LDFLAGS_JDKEXE@
 
